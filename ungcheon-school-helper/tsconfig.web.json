{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "react-jsx",
    "target": "ESNext",
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] },
    "skipLibCheck": true
  },
  "include": [
    "src/main.tsx",
    "src/App.tsx",
    "src/global.d.ts",
    "src/vite-env.d.ts",
    "src/styles/**/*",
    "src/types/**/*",
    "src/stores/**/*",
    "src/components/**/*",
    "src/utils/**/*",
    "src/data/weatherCoords.ts",
    "src/data/recommendedSubjects.ts",
    "src/pages/Dashboard.tsx",
    "src/pages/NeisPage.tsx",
    "src/pages/UngcheonSettingsPage.tsx",
    "src/pages/UngcheonHelpPage.tsx",
    "src/pages/SchoolHubPage.tsx",
    "src/pages/ExcelProcessorPage.tsx",
    "src/pages/RecommendedSubjectsPage.tsx",
    "src/pages/PayrollPage.tsx",
    "src/pages/AfterSchoolCheckerPage.tsx",
    "src/pages/InsaAnalysisPage.tsx",
    "src/pages/WorkReducerPage.tsx",
    "src/pages/workReducer/**/*",
    "src/pages/CurriculumPage.tsx",
    "src/pages/PhotoLedgerPage.tsx",
    "src/pages/PhotoLedgerPage.css",
    "src/pages/StudentRecordPage.tsx",
    "src/pages/AttendancePage.tsx",
    "src/pages/SchoolCommitteesPage.tsx",
    "src/pages/SchoolLedgerPage.tsx",
    "src/pages/PdfExtractorPage.tsx",
    "src/pages/FileParserPage.tsx",
    "src/pages/NotifierPage.tsx",
    "src/services/neis.ts",
    "src/services/schoolHub.ts",
    "src/services/hobong.ts",
    "src/services/hobongExcel.ts",
    "src/services/insa/**/*",
    "src/services/workReducer/**/*",
    "src/services/photoLedger.ts",
    "src/services/fileParser/**/*"
  ]
}
